# true exercises the mobile flow with clearly labeled canned responses.
# Keep false to use real Groq inference after adding your key.
DEMO_MODE=false
HOST=127.0.0.1
PORT=8000
# Create a key at https://console.groq.com/keys. Keep it on the backend only.
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Install FFmpeg and add it to PATH, or set its full executable path here.
FFMPEG_PATH=ffmpeg
# Shopping search (real products, prices and store links) via SerpApi Google Shopping.
# Create a key at https://serpapi.com/manage-api-key. Without it the assistant cannot shop.
SERPAPI_KEY=
# Two-letter country code for stores and currency, e.g. us, pk, gb, in.
SHOPPING_COUNTRY=us
